# Copy to .env and adjust. Every value below is the default used when the variable is not set.

# Transcription engine: "faster-whisper" (real model) or "fake" (deterministic, for tests/dev).
ENGINE=faster-whisper

# Hugging Face model repo id loaded by faster-whisper.
WHISPER_MODEL=Systran/faster-whisper-small
# "cpu" or "cuda".
WHISPER_DEVICE=cpu
# CTranslate2 compute type, e.g. int8 (CPU), float16 (GPU).
WHISPER_COMPUTE_TYPE=int8

# Upload limits.
MAX_UPLOAD_MB=200
MAX_DURATION_SEC=3600

# Redis connection. Inside Docker Compose the host is "redis";
# when running the API on your machine use redis://localhost:6379/0.
REDIS_URL=redis://redis:6379/0

# Where uploaded files are stored until the worker processes them.
UPLOAD_DIR=/data/uploads

# How long job status and results are kept in Redis.
JOB_TTL_HOURS=24
# Maximum time a single transcription job may run.
JOB_TIMEOUT_SEC=3600

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# "text" (human readable) or "json" (for log aggregators).
LOG_FORMAT=text
